<?xml version="1.0" encoding="utf-8"?>
<!-- Sub TTS — ban rieng chay song song app Netflix goc.
  Bo WebView + offset. UI hien dai: the cau dang doc + nut Play/Pause tron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tieu de -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sub TTS"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoiceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1C2128"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Google"
                android:textColor="#58A6FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chua co phu de — chon file .srt"
            android:textColor="#8B949E"
            android:textSize="13sp" />

        <!-- TAB Xem: the cau + dieu khien phat -->
        <LinearLayout
            android:id="@+id/paneWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- The cau dang doc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#161B22"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANG DOC"
                android:textColor="#58A6FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="56dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="..."
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="00:00:00 / 00:00:00"
                android:textColor="#58A6FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Con lai: --:--:--"
                android:textColor="#FFB74D"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="1000" />

        <!-- Hang dieu khien: ⏮ | Play | ⏭ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevCue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏮"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnPlayPause"
                style="@style/Widget.SubTTS.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="2"
                android:minHeight="56dp"
                android:text="▶  Play" />

            <Button
                android:id="@+id/btnNextCue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="⏭"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Can gio dem nguoc voi Netflix: tong phim + Luu + nhap gio con lai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTotalLen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tổng phim (vd 1:32:00)"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7681"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSetTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Lưu" />

            <Button
                android:id="@+id/btnJumpRemain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⏱"
                android:textSize="16sp" />
        </LinearLayout>

        </LinearLayout>

        <!-- TAB Tim sub: chon file + online + sao luu -->
        <LinearLayout
            android:id="@+id/paneSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Chon sub -->
        <Button
            android:id="@+id/btnPickSrt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📁  Chon file phu de (.srt)"
            android:textSize="14sp" />

        <!-- Tim sub online -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSubSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔍  Tim sub online"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSubSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🔑  Key sub"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sao luu / khoi phuc cai dat + key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾  Sao luu"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="📥  Khoi phuc"
                android:textSize="13sp" />
        </LinearLayout>

        </LinearLayout>

        <!-- TAB Sub da luu -->
        <LinearLayout
            android:id="@+id/paneSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnClearSavedSubs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🗑  Xoa tat ca sub da luu"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/llSavedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- TAB Cai dat: hen gio + giong + toc do + volume + nut noi + thoat -->
        <LinearLayout
            android:id="@+id/paneSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Hen gio tat doc -->

        <!-- Hen gio tat doc -->
        <Button
            android:id="@+id/btnSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⏾  Hen gio tat: Tat"
            android:textSize="14sp" />

        <!-- Giong doc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Giong doc"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoiceGoogle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Google\n(offline)"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnVoiceHoaiMy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="HoaiMy\n(online)"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnVoiceNamMinh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="NamMinh\n(online)"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnVoiceVieneu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Vieneu\n(PC)"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Server Vieneu tren PC nha -->
        <Button
            android:id="@+id/btnVieneuServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🖥  Server Vieneu (PC)"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnVieneuPreload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="⚙  Preload Vieneu: 10 cau"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGoogleVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎙  Giong Google: mac dinh"
            android:textSize="13sp" />

        <!-- Toc do -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Toc do doc"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="200"
                android:progress="50" />

            <TextView
                android:id="@+id/tvRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Volume sub -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Am luong giong doc"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekTtsVol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100" />

            <TextView
                android:id="@+id/tvTtsVol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Co chu cau dang doc -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Co chu cau dang doc"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekCueSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="18"
                android:progress="5" />

            <TextView
                android:id="@+id/tvCueSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="17"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nut noi + xoa cache -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFloat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🫧  Nut noi"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnClearCache"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Xoa cache"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Thoat han app (tat chay nen) -->
        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:backgroundTint="#A40E26"
            android:text="⏻  Thoat app (tat chay nen)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cach dung: chon .srt → Play → thoat sang app Netflix xem. Dieu khien nhanh bang nut noi mo 30% tren man hinh Netflix."
            android:textColor="#6E7681"
            android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- Thanh tab duoi kieu mau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnTabWatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:text="▶  Xem"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTabSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:text="🔍  Tim sub"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTabSaved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minHeight="54dp"
            android:text="💾  Da luu"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
